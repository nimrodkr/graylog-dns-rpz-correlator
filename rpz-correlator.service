[Unit]
Description=A10 RPZ Graylog Correlator
After=network-online.target opensearch.service graylog-server.service
Wants=network-online.target

[Service]
Type=simple
User=rpzcorrelator
Group=rpzcorrelator
WorkingDirectory=/opt/rpz-correlator
EnvironmentFile=/etc/rpz-correlator/rpz-correlator.env

ExecStart=/opt/rpz-correlator/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - --timeout 30 rpz_correlator:app

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/rpz-correlator

[Install]
WantedBy=multi-user.target
