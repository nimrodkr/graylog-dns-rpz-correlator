# ============================================================
# Graylog DNS RPZ Correlator
# ============================================================

# OpenSearch
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=graylog_*
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_TLS=true

# Graylog Syslog UDP input
GRAYLOG_HOST=127.0.0.1
GRAYLOG_PORT=5140

# Polling
POLL_INTERVAL_SECONDS=60
LOOKBACK_SECONDS=90

# DNS matching window around each Policy timestamp
WINDOW_BEFORE_MS=3000
WINDOW_AFTER_MS=1000

# OpenSearch request timeout
REQUEST_TIMEOUT=5

# SQLite duplicate-protection state
STATE_DB=/var/lib/graylog-dns-rpz-correlator/state.db

# Keep processed Policy IDs for 5 minutes
STATE_RETENTION_SECONDS=300

# Logging verbosity
RPZ_DEBUG=1
