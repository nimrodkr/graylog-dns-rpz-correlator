rule "process_rpz_policy"
when
    contains(to_string($message.message), "Policy Zone=")
then
    let raw_msg = to_string($message.message);

    //
    // RPZ Policy Zone
    //
    let rpz_policy_zone = regex_replace(
        ".*Policy Zone=([^,]+),.*",
        raw_msg,
        "$1"
    );

    //
    // Extract Trigger Reason (strip the +5 automatically)
    //
    let domain_tmp = lowercase(regex_replace(
        ".*Trigger Reason=([^,+]+)\\+[0-9]+,.*",
        raw_msg,
        "$1"
    ));

    //
    // Remove optional wildcard prefix (*.example.com -> example.com)
    //
    let rpz_domain_full = regex_replace(
        "^\\*?\\.",
        domain_tmp,
        ""
    );

    //
    // Registered/root domain
    //
    let rpz_domain = regex_replace(
        "^.*?([a-zA-Z0-9\\-]+\\.[a-zA-Z]{2,})$",
        rpz_domain_full,
        "$1"
    );

    //
    // Lookup client IP using the FULL hostname
    //
    let rpz_client_ip = lookup_value(
        "dns_lookup",
        to_string(rpz_domain_full)
    );

    //
    // RPZ Action
    //
    let rpz_action = regex_replace(
        ".*Action Type=([^,]+),.*",
        raw_msg,
        "$1"
    );

    //
    // Store RPZ fields
    //
    set_field("rpz_policy_zone", rpz_policy_zone);
    set_field("rpz_domain_full", rpz_domain_full);
    set_field("rpz_domain", rpz_domain);
    set_field("rpz_client_ip", rpz_client_ip);
    set_field("rpz_action", rpz_action);

    route_to_stream(name: "RPZ Policy Log");
end
